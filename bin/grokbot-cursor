#!/usr/bin/python3
"""Print Hyprland cursor positions as "x y" lines, only when they change.

A layer surface only sees the pointer while it is over that surface, so the
companion cannot follow the mouse from QML alone. This asks Hyprland's
request socket for cursorpos and slows down while the pointer rests.

The shell starts it as: /usr/bin/python3 -I -S bin/grokbot-cursor
with a cleared environment that contains only HYPRLAND_INSTANCE_SIGNATURE
and XDG_RUNTIME_DIR. It also prints "down" or "up" when the left button
changes, read from mouse event nodes. Other events are discarded, and the
devices are not grabbed. At start it prints "buttons 1" when at least one
mouse event node could be opened (usually membership of the input group) and
"buttons 0" when none could, so the shell knows whether "up" will ever come.

Hyprland is asked at most 30 times a second while the pointer moves, 5 times
a second for ten seconds after it stops, then once a second. Mouse motion on
an open event node cuts a resting wait short, so a move is noticed at once;
without event nodes the resting poll stays at 5 times a second.
"""
import os
import re
import select
import socket
import struct
import sys
import time

REPLY_LIMIT = 64
FAST = 1 / 30
SLOW = 1 / 5
IDLE = 1.0
REST_AFTER = 2.0
IDLE_AFTER = 10.0
FAILURE_BUDGET = 40
POSITION = re.compile(rb"\s*(-?\d{1,6}), (-?\d{1,6})\s*")
# struct input_event from linux/input.h: a native timeval (two C longs), then
# type, code, value. Only BTN_LEFT is inspected; nothing else is printed.
EVENT = struct.Struct("@llHHi")
EV_KEY = 1
BTN_LEFT = 0x110


def socket_path():
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not re.fullmatch(r"[A-Za-z0-9_]{1,160}", signature):
        return None
    if not re.fullmatch(r"/run/user/\d{1,10}", runtime):
        return None
    return f"{runtime}/hypr/{signature}/.socket.sock"


def ask(path):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC) as sock:
        sock.settimeout(0.5)
        sock.connect(path)
        sock.sendall(b"cursorpos")
        reply = b""
        while len(reply) <= REPLY_LIMIT:
            chunk = sock.recv(REPLY_LIMIT + 1 - len(reply))
            if not chunk:
                break
            reply += chunk
    if len(reply) > REPLY_LIMIT:
        raise ValueError("reply too long")
    match = POSITION.fullmatch(reply)
    if not match:
        raise ValueError("unexpected reply")
    return int(match.group(1)), int(match.group(2))


def mouse_event_nodes(text):
    """Event nodes that are mice. A keyboard that also has a mouse node counts."""
    found = []
    for block in str(text or "").split("\n\n"):
        handlers = ""
        for line in block.splitlines():
            if line.startswith("H: Handlers="):
                handlers = line.split("=", 1)[1]
        tokens = handlers.split()
        if not any(re.fullmatch(r"mouse\d+", token) for token in tokens):
            continue
        for token in tokens:
            if re.fullmatch(r"event\d+", token):
                found.append(f"/dev/input/{token}")
    return found


def button_edges(down, fd, value):
    """Return down/up when the combined left button changes. value 2 is repeat."""
    if value == 2:
        return []
    was = any(down.values())
    down[fd] = value != 0
    now = any(down.values())
    if now and not was:
        return ["down"]
    if was and not now:
        return ["up"]
    return []


class LeftButton:
    """Watch BTN_LEFT on mouse event nodes. Never grabs the device."""

    def __init__(self, nodes):
        self.fds = []
        self.buffers = {}
        self.down = {}
        for path in nodes:
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
            except OSError:
                continue
            self.fds.append(fd)
            self.buffers[fd] = bytearray()
            self.down[fd] = False

    def close(self):
        for fd in self.fds:
            os.close(fd)
        self.fds = []

    def drain(self):
        """Read what is queued. Returns (edges, activity): any event counts as activity."""
        edges = []
        activity = False
        size = EVENT.size
        for fd in self.fds:
            buf = self.buffers[fd]
            while True:
                try:
                    chunk = os.read(fd, size * 64)
                except OSError:
                    break
                if not chunk:
                    break
                activity = True
                buf.extend(chunk)
            while len(buf) >= size:
                _sec, _usec, typ, code, value = EVENT.unpack_from(buf)
                del buf[:size]
                if typ != EV_KEY or code != BTN_LEFT:
                    continue
                edges.extend(button_edges(self.down, fd, value))
        return edges, activity

    def wait(self, deadline, earliest, clock=time.monotonic):
        """Wait until deadline, returning button edges.

        A button edge returns at once. Other input (motion) only ends the wait
        early once earliest has passed, so a fast mouse cannot make the caller
        ask Hyprland more often than its fastest interval.
        """
        edges = []
        while True:
            now = clock()
            if now >= deadline:
                break
            if not self.fds:
                time.sleep(deadline - now)
                break
            try:
                readable, _, _ = select.select(self.fds, [], [], deadline - now)
            except OSError:
                time.sleep(max(0.0, deadline - clock()))
                break
            if not readable:
                break
            found, activity = self.drain()
            edges.extend(found)
            if edges:
                return edges
            if activity:
                now = clock()
                if now >= earliest:
                    break
                # Motion inside the fast window: wait it out without spinning
                # on a busy node, then pick up anything that arrived meanwhile.
                time.sleep(min(deadline, earliest) - now)
                found, _ = self.drain()
                edges.extend(found)
                if edges or clock() >= earliest:
                    break
            else:
                # Readable but nothing read (an error or end of file): stop
                # watching that wake source for this wait.
                time.sleep(max(0.0, deadline - clock()))
                break
        found, _ = self.drain()
        edges.extend(found)
        return edges


def poll_interval(still_for, watching):
    """Seconds between cursorpos requests after the pointer has been still for still_for."""
    if still_for < REST_AFTER:
        return FAST
    if watching and still_for >= IDLE_AFTER:
        return IDLE
    return SLOW


def emit(line):
    sys.stdout.write(line + "\n")
    sys.stdout.flush()


def run(request, buttons, write, alive, clock=time.monotonic):
    """The main loop. Returns the exit status."""
    last = None
    moved_at = clock()
    failures = 0
    try:
        write(f"buttons {1 if buttons.fds else 0}")
    except BrokenPipeError:
        return 0
    while alive():
        started = clock()
        try:
            edges, _ = buttons.drain()
            for edge in edges:
                write(edge)
            position = request()
            failures = 0
            if position != last:
                write(f"{position[0]} {position[1]}")
                last = position
                moved_at = started
        except BrokenPipeError:
            return 0
        except (OSError, ValueError):
            failures += 1
            if failures >= FAILURE_BUDGET:
                return 1
            time.sleep(min(2.0, 0.1 * failures))
            continue
        interval = poll_interval(started - moved_at, bool(buttons.fds))
        try:
            for edge in buttons.wait(started + interval, started + FAST, clock):
                write(edge)
        except BrokenPipeError:
            return 0
    return 0


def self_test():
    sample = (
        "N: Name=\"Keyboard\"\nH: Handlers=kbd event2\n\n"
        "N: Name=\"Combo\"\nH: Handlers=kbd event7 mouse1\n\n"
        "N: Name=\"Mouse\"\nH: Handlers=event5 mouse0\n"
    )
    assert mouse_event_nodes(sample) == ["/dev/input/event7", "/dev/input/event5"]
    assert mouse_event_nodes("H: Handlers=kbd event2\n") == []
    down = {1: False, 2: False}
    assert button_edges(down, 1, 1) == ["down"]
    assert button_edges(down, 1, 2) == []
    assert button_edges(down, 2, 1) == []
    assert button_edges(down, 1, 0) == []
    assert button_edges(down, 2, 0) == ["up"]
    # Two native longs, then u16 type, u16 code, s32 value.
    assert EVENT.size == struct.calcsize("@llHHi")
    assert poll_interval(0.0, True) == FAST
    assert poll_interval(REST_AFTER, True) == SLOW
    assert poll_interval(IDLE_AFTER, True) == IDLE
    assert poll_interval(IDLE_AFTER * 10, False) == SLOW
    read, write = os.pipe()
    try:
        os.set_blocking(read, False)
        watcher = LeftButton([])
        watcher.fds = [read]
        watcher.buffers[read] = bytearray()
        watcher.down[read] = False
        os.write(write, EVENT.pack(0, 0, 2, 0, 5) + EVENT.pack(0, 0, EV_KEY, BTN_LEFT, 1))
        now = time.monotonic()
        assert watcher.wait(now + 1.0, now + FAST) == ["down"]
        assert time.monotonic() - now < 0.5
    finally:
        os.close(read)
        os.close(write)
    return 0


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "--self-test":
        return self_test()
    path = socket_path()
    if path is None:
        return 2
    try:
        with open("/proc/bus/input/devices", encoding="utf-8", errors="replace") as handle:
            nodes = mouse_event_nodes(handle.read(1 << 20))
    except OSError:
        nodes = []
    buttons = LeftButton(nodes)
    parent = os.getppid()
    try:
        return run(lambda: ask(path), buttons, emit, lambda: os.getppid() == parent)
    finally:
        buttons.close()


if __name__ == "__main__":
    sys.exit(main())
