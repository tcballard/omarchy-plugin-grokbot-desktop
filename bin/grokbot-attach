#!/usr/bin/python3
"""Capture or collect one image to attach to the next ask.

  grokbot-attach screenshot   pick an area with slurp and capture it with grim
  grokbot-attach paste        save the image on the Wayland clipboard
  grokbot-attach file PATH    copy a dropped image file

Each saves a private copy under $XDG_RUNTIME_DIR/grokbot-desktop/attachments
(mode 0700, cleared at logout) and prints its path. Only PNG, JPEG, WebP, and
GIF images up to 10 MB are kept; anything else is refused with a reason on
stderr. Copies older than a day are removed on each run.

The shell starts it as /usr/bin/python3 -I with a cleared environment that
holds only XDG_RUNTIME_DIR, WAYLAND_DISPLAY, and HYPRLAND_INSTANCE_SIGNATURE.
"""
from __future__ import annotations

import os
import re
import secrets
import stat
import subprocess
import sys
import time

LIMIT = 10 * 1024 * 1024
MAX_AGE = 24 * 3600
TRUSTED = ("/usr/bin", "/bin")
EXIT_CANCELLED = 3
EXIT_NO_IMAGE = 4
SIGNATURES = (
    (b"\x89PNG\r\n\x1a\n", "png"),
    (b"\xff\xd8\xff", "jpg"),
    (b"GIF87a", "gif"),
    (b"GIF89a", "gif"),
)


def kind(head):
    for magic, ext in SIGNATURES:
        if head.startswith(magic):
            return ext
    if len(head) >= 12 and head[:4] == b"RIFF" and head[8:12] == b"WEBP":
        return "webp"
    return ""


def store_dir():
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not re.fullmatch(r"/run/user/\d{1,10}", runtime):
        return ""
    path = os.path.join(runtime, "grokbot-desktop", "attachments")
    os.makedirs(path, mode=0o700, exist_ok=True)
    for part in (os.path.dirname(path), path):
        st = os.lstat(part)
        if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
            return ""
        os.chmod(part, 0o700)
    return path


def prune(directory):
    now = time.time()
    for name in os.listdir(directory):
        full = os.path.join(directory, name)
        try:
            st = os.lstat(full)
        except OSError:
            continue
        if stat.S_ISREG(st.st_mode) and now - st.st_mtime > MAX_AGE:
            try:
                os.unlink(full)
            except OSError:
                pass


def save(directory, data):
    ext = kind(data[:16])
    if not ext:
        print("that is not a PNG, JPEG, WebP, or GIF image", file=sys.stderr)
        return 2
    if len(data) > LIMIT:
        print("that image is larger than 10 MB", file=sys.stderr)
        return 2
    path = os.path.join(directory, f"{time.strftime('%Y%m%d-%H%M%S')}-{secrets.token_hex(4)}.{ext}")
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as handle:
        handle.write(data)
    print(path)
    return 0


def tool(name):
    for directory in TRUSTED:
        candidate = os.path.join(directory, name)
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return ""


def child_env():
    keep = ("XDG_RUNTIME_DIR", "WAYLAND_DISPLAY", "HYPRLAND_INSTANCE_SIGNATURE")
    env = {"PATH": "/usr/bin:/bin"}
    for key in keep:
        if os.environ.get(key):
            env[key] = os.environ[key]
    return env


def screenshot(directory):
    slurp = tool("slurp")
    grim = tool("grim")
    if not slurp or not grim:
        print("screenshots need slurp and grim", file=sys.stderr)
        return 127
    picked = subprocess.run([slurp], capture_output=True, env=child_env(), timeout=120)
    geometry = picked.stdout.decode("utf-8", errors="replace").strip()
    if picked.returncode != 0 or not re.fullmatch(r"-?\d+,-?\d+ \d+x\d+", geometry):
        return EXIT_CANCELLED
    shot = subprocess.run([grim, "-g", geometry, "-t", "png", "-"], capture_output=True, env=child_env(), timeout=30)
    if shot.returncode != 0 or not shot.stdout:
        print("the screenshot failed", file=sys.stderr)
        return 1
    return save(directory, shot.stdout[: LIMIT + 1])


def paste(directory):
    wl_paste = tool("wl-paste")
    if not wl_paste:
        print("pasting images needs wl-clipboard", file=sys.stderr)
        return 127
    listed = subprocess.run([wl_paste, "--list-types"], capture_output=True, env=child_env(), timeout=5)
    types = listed.stdout.decode("utf-8", errors="replace").split()
    for wanted in ("image/png", "image/jpeg", "image/webp", "image/gif"):
        if wanted in types:
            got = subprocess.run([wl_paste, "--no-newline", "--type", wanted], capture_output=True, env=child_env(), timeout=10)
            if got.returncode == 0 and got.stdout:
                return save(directory, got.stdout[: LIMIT + 1])
    return EXIT_NO_IMAGE


def from_file(directory, path):
    path = path[7:] if path.startswith("file://") else path
    try:
        st = os.lstat(path)
    except OSError:
        print("that file could not be read", file=sys.stderr)
        return 2
    if not stat.S_ISREG(st.st_mode):
        print("only regular image files can be attached", file=sys.stderr)
        return 2
    if st.st_size > LIMIT:
        print("that image is larger than 10 MB", file=sys.stderr)
        return 2
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as handle:
        data = handle.read(LIMIT + 1)
    return save(directory, data)


def main(argv):
    if not argv or argv[0] not in ("screenshot", "paste", "file") or (argv[0] == "file") != (len(argv) == 2):
        print("usage: grokbot-attach screenshot | paste | file PATH", file=sys.stderr)
        return 2
    directory = store_dir()
    if not directory:
        print("no private runtime directory for attachments", file=sys.stderr)
        return 1
    prune(directory)
    try:
        if argv[0] == "screenshot":
            return screenshot(directory)
        if argv[0] == "paste":
            return paste(directory)
        return from_file(directory, argv[1])
    except (OSError, subprocess.SubprocessError):
        print("the image could not be saved", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
