#!/usr/bin/python3
"""Forward one IPC call to the Grok Bot companion.

  grokbot-desktop-ctl dictate          # private text on stdin only
  grokbot-desktop-ctl summon

Dictation and asynchronous replies go to the Agent Desktop daemon's private socket
($XDG_RUNTIME_DIR/agent-desktop/ctl.sock) when the daemon backend is running, and otherwise
to Omarchy's user-private shell socket, never through argv. The shell socket is used only when
the daemon socket is absent or nothing is listening on it, so no input is delivered twice.
Other methods retain the ordinary omarchy-shell command interface.
"""
from __future__ import annotations

import hashlib
import os
import re
import shutil
import socket
import stat
import struct
import sys
import time
from pathlib import Path

TARGET = "io.github.tcballard.grokbot-desktop"
METHOD = re.compile(r"^[A-Za-z][A-Za-z0-9]{0,31}$")
TEXT_LIMIT = 4000
IPC_TIMEOUT = 2.0
REPLY_LIMIT = 4096


DAEMON_MAGIC = "agent-desktop/1"


class NotListening(Exception):
    """Nothing accepted the connection, so nothing can have been delivered."""


def runtime_dir() -> Path:
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
    info = runtime.stat()
    if (not runtime.is_absolute() or not stat.S_ISDIR(info.st_mode)
            or info.st_uid != os.getuid() or info.st_mode & 0o077):
        raise ValueError("XDG_RUNTIME_DIR must be a private directory owned by you")
    return runtime


def daemon_socket() -> str | None:
    """The daemon's control socket, or None when the daemon backend is not running."""
    directory = runtime_dir() / "agent-desktop"
    try:
        info = os.lstat(directory)
    except FileNotFoundError:
        return None
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise ValueError("The agent-desktop runtime directory must be private and owned by you")
    path = directory / "ctl.sock"
    try:
        info = os.lstat(path)
    except FileNotFoundError:
        return None
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
        raise ValueError("The agent-desktop control socket must be owned by you")
    return str(path)


def dictation_socket() -> str:
    """Match omarchy-shell's config/display-scoped socket, in a private dir."""
    runtime = runtime_dir()
    omarchy = os.environ.get("OMARCHY_PATH", "")
    if not omarchy or not Path(omarchy, "shell", "shell.qml").is_file():
        raise ValueError("OMARCHY_PATH must point to your Omarchy installation")
    display = os.environ.get("WAYLAND_DISPLAY", "")
    if not display or not (runtime / display).exists():
        displays = [p for p in runtime.glob("wayland-[0-9]*")
                    if not p.name.endswith(".lock") and p.is_socket()]
        if displays:
            display = max(displays, key=lambda p: p.stat().st_mtime_ns).name
    identity = hashlib.md5(f"{omarchy}/shell\n{display}".encode("utf-8")).hexdigest()[:16]
    path = runtime / f"omarchy-shell-{identity}.sock"
    info = path.stat()
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
        raise ValueError("Omarchy's IPC socket must be owned by you")
    return str(path)


def exchange(path: str, request: bytes, refused_ok: bool = False) -> bytes:
    """Send one request and return the reply frame, without its record separator."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        deadline = time.monotonic() + IPC_TIMEOUT
        client.settimeout(IPC_TIMEOUT)
        try:
            client.connect(path)
        except (ConnectionRefusedError, FileNotFoundError):
            if refused_ok:
                raise NotListening() from None
            raise
        peer = client.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
        if struct.unpack("3i", peer)[1] != os.getuid():
            raise ValueError("The IPC peer must be owned by you")
        client.sendall(request)
        reply = bytearray()
        while b"\x1e" not in reply:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError()
            client.settimeout(remaining)
            chunk = client.recv(REPLY_LIMIT + 1 - len(reply))
            if not chunk or len(reply) + len(chunk) > REPLY_LIMIT:
                raise ValueError("Incomplete or oversized IPC reply")
            reply.extend(chunk)
    return bytes(reply).split(b"\x1e", 1)[0]


def private_call(method: str, *fields: str) -> int:
    # These bytes delimit fields and records in both IPC protocols.
    # Refuse them, never retry through qs/omarchy-shell with text in argv.
    if any(char in field for field in fields for char in ("\x00", "\x1e", "\x1f")):
        print("Input contains unsupported IPC control characters", file=sys.stderr)
        return 2
    try:
        frame = None
        path = daemon_socket()
        if path is not None:
            request = "\x1f".join((DAEMON_MAGIC, method, *fields)) + "\x1e"
            try:
                frame = exchange(path, request.encode("utf-8"), refused_ok=True)
            except NotListening:
                frame = None  # A stale daemon socket: the shell socket below is the only delivery.
        if frame is None:
            request = "\x1f".join((TARGET, method, *fields)) + "\x1e"
            frame = exchange(dictation_socket(), request.encode("utf-8"))
    except (OSError, ValueError):
        # A failed/partial reply can mean the call already ran. No retry,
        # and no raw error or reply that might contain the private text.
        print("Private IPC failed; check OMARCHY_PATH and XDG_RUNTIME_DIR, "
              "and update/restart the Omarchy shell. Delivery was not confirmed.", file=sys.stderr)
        return 1
    if frame in (b"OK\x1fok", b"OK\x1fopened"):
        return 0
    if frame == b"SKIP":
        print("Private IPC is unavailable; update the plugin and restart the Omarchy shell.", file=sys.stderr)
    else:
        print("The companion did not accept the input.", file=sys.stderr)
    return 1


def main(argv: list[str]) -> int:
    if not argv or not METHOD.fullmatch(argv[0]):
        print("Usage: grokbot-desktop-ctl <method> [args...]", file=sys.stderr)
        return 2
    if argv[0] == "dictate":
        if len(argv) != 1:
            print("Usage: grokbot-desktop-ctl dictate < transcript.txt (text on stdin only)", file=sys.stderr)
            return 2
        text = sys.stdin.read(TEXT_LIMIT + 1)[:TEXT_LIMIT]
        if text.endswith("\n"):
            text = text[:-1]
        return private_call("dictate", text)
    if argv[0] == "reply":
        if len(argv) != 2 or not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", argv[1]):
            print("Usage: grokbot-desktop-ctl reply <askId> < answer.txt (answer on stdin only)", file=sys.stderr)
            return 2
        text = sys.stdin.read(TEXT_LIMIT + 1)
        if len(text) > TEXT_LIMIT:
            print("Reply exceeds 4000 characters", file=sys.stderr)
            return 2
        return private_call("reply", argv[1], text)
    args = [argv[0], *argv[1:]]
    shell = shutil.which("omarchy-shell")
    if not shell:
        print("omarchy-shell is not on PATH", file=sys.stderr)
        return 1
    os.execv(shell, [shell, TARGET, *args])
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
