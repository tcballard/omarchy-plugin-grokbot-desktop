#!/usr/bin/python3
"""Dispatch one companion prompt: the Grok Bot adapter's per-ask worker.

Stdin is a JSON object: {"askId"?,"botId","botName","prompt","host"?,"attachments"?}.
A reply is printed on stdout; a failure names its cause in one line on
stderr. Exit codes: 0 answered, 2 invalid request or settings, 3 webhook
credentials missing or not private, 4 webhook failed, 10 the routine took
the ask and will answer through the reply command, 124 the agent timed out,
125 output ceiling, 127 agent unavailable, 130 stopped by SIGTERM; other
codes are the agent's own.

The logic lives in agent_desktop/transport.py. This file stays a separate
process per ask, launched as /usr/bin/python3 -I, so the adapter can stop it
and its agent's process group. Loaded as a module it forwards to the
transport, for older callers.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from agent_desktop import transport  # noqa: E402


def __getattr__(name):
    return getattr(transport, name)


if __name__ == "__main__":
    sys.exit(transport.main())
