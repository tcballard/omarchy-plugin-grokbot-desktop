#!/usr/bin/python3
"""Route a "Hey Bot" / "Hey <name>" dictation, for Superwhisper and Voxtype.

The same rules run for both backends. A wake phrase at the start selects
the roster bot and returns the rest of the sentence. Other text is ignored.

  grokbot-dictation-route            stdin -> JSON, exit 0 when matched
  grokbot-dictation-route --filter   Voxtype [output.post_process] filter
  grokbot-dictation-route --wtype    type with wtype, or route a wake phrase

--filter reads the transcript on stdin. A wake phrase is handed to
grokbot-desktop-ctl and omitted from stdout so Voxtype does not type it
(set fallback_on_empty = false). Any other transcript is written back
byte for byte, whatever its length. If the companion cannot be reached,
the original text is written back so the dictation is not discarded.

--wtype is the same decision in front of wtype. A wake phrase is not typed;
any other text is typed with `wtype -`, the text on stdin.

Wake phrases are matched against the roster the companion shows: the synced
$XDG_CONFIG_HOME/omarchy/grokbot-bots.json or ~/.config/omarchy/grokbot-bots.json
(symlinks, non-regular files and files over 1 MiB are ignored), else the bundled
data/bots.json. GROKBOT_BOTS=<path> overrides all of them.
Only the first 4000 characters of a wake line are routed.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agent_desktop.wake import (  # noqa: E402
    CLIP_WINDOW, DEDUP_SECONDS, PRIMARY_ID, TEXT_LIMIT, deliver, load_bots, normalize,
    recording_finished, route, should_deliver,
)

__all__ = ["CLIP_WINDOW", "DEDUP_SECONDS", "PRIMARY_ID", "TEXT_LIMIT", "deliver", "load_bots",
           "normalize", "recording_finished", "route", "should_deliver"]

# How much of stdin is held to decide. Longer input is still passed through whole.
READ_LIMIT = 1024 * 1024
CHUNK = 65536


def read_head(stream) -> bytes:
    chunks = []
    left = READ_LIMIT
    while left > 0:
        chunk = stream.read(min(left, CHUNK))
        if not chunk:
            break
        chunks.append(chunk)
        left -= len(chunk)
    return b"".join(chunks)


def copy_rest(stream, sink) -> None:
    while True:
        chunk = stream.read(CHUNK)
        if not chunk:
            return
        sink.write(chunk)


def decode(data: bytes) -> str:
    return data.decode("utf-8", errors="replace")


def real_wtype() -> str:
    override = os.environ.get("GROKBOT_WTYPE", "")
    if override:
        return override
    own = Path(__file__).resolve()
    for directory in os.environ.get("PATH", "").split(":"):
        if not directory:
            continue
        candidate = Path(directory) / "wtype"
        try:
            if candidate.resolve() == own:
                continue
        except (OSError, RuntimeError):
            continue
        if os.access(candidate, os.X_OK):
            return str(candidate)
    return ""


def filter_text(text: str, bots: list, backend: str) -> str:
    """The text Voxtype should type: nothing for a delivered wake line, else the input."""
    if route(text, bots)["matched"] and deliver(text, backend):
        return ""
    return text


def type_text(head: bytes, stream) -> int:
    typer = real_wtype()
    out = sys.stdout.buffer
    if not typer:
        out.write(head)
        copy_rest(stream, out)
        return 0
    try:
        proc = subprocess.Popen([typer, "-"], stdin=subprocess.PIPE)
    except OSError:
        print("wtype could not be started", file=sys.stderr)
        return 127
    try:
        proc.stdin.write(head)
        copy_rest(stream, proc.stdin)
        proc.stdin.close()
    except BrokenPipeError:
        pass
    return proc.wait()


def parse_args(argv: list[str]):
    mode = "json"
    backend = os.environ.get("GROKBOT_DICTATION_BACKEND", "")
    if "--filter" in argv:
        mode = "filter"
    elif "--wtype" in argv:
        mode = "wtype"
    if "--backend" in argv:
        index = argv.index("--backend")
        if index + 1 >= len(argv):
            raise ValueError("--backend needs superwhisper or voxtype")
        backend = argv[index + 1]
    if backend not in ("", "superwhisper", "voxtype"):
        raise ValueError("backend must be superwhisper or voxtype")
    return mode, backend


def main(argv: list[str]) -> int:
    try:
        mode, backend = parse_args(argv)
    except ValueError as error:
        print(error, file=sys.stderr)
        return 2
    bots = load_bots()
    stream = sys.stdin.buffer
    head = read_head(stream)
    text = decode(head)
    decided = route(text, bots)

    if mode == "json":
        json.dump(decided, sys.stdout)
        sys.stdout.write("\n")
        return 0 if decided["matched"] else 1
    if mode == "filter":
        if decided["matched"] and deliver(text, backend or "voxtype"):
            return 0
        sys.stdout.buffer.write(head)
        copy_rest(stream, sys.stdout.buffer)
        return 0
    if decided["matched"] and deliver(text, backend or "superwhisper"):
        return 0
    return type_text(head, stream)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except BrokenPipeError:
        raise SystemExit(0)
