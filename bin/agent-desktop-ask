#!/usr/bin/python3 -I
"""Compatibility boundary between the desktop's one-shot ask and Provider API v1.

By default stdout carries only the completed reply. When the request asks for
"stream": true, stdout is JSON Lines instead, one object per line, for the shell to
show the reply as it is written:

  {"ev": "delta", "text": <the reply so far>}
  {"ev": "progress", "text": <what the agent is doing>}
  {"ev": "final", "text": <the completed reply>}

A streaming ask also carries the agent's approvals and questions, and keeps stdin
open for the answers (one JSON object per line):

  out: {"ev": "prompt", "promptId", "kind", "text", "command", "choices",
        "multiSelect", "answerable"}
  out: {"ev": "settled", "promptId"}           answered anywhere, or withdrawn
  in:  {"op": "answer", "promptId", "answer"}
  out: {"ev": "answered", "promptId", "ok", "text"?}

The request itself is the first line on stdin (or all of it, for a plain ask).
A plain ask stops when the agent needs approval or input. Exit codes and stderr
are the same either way."""
import argparse
import asyncio
import json
import os
import re
from pathlib import Path
import signal
import stat
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agent_desktop.config import client_for, timeout_seconds
from agent_desktop.protocol import Fault, decode, identifier, text, MAX_PROMPT, MAX_FRAME


def prompt_line(params):
    choices = params.get('choices')
    command = params.get('command') or ''
    description = params.get('text', '')
    if not isinstance(description, str):
        description = ''
    kind = 'clarify' if params.get('kind') == 'clarify' else 'approval'
    answerable = (
        params.get('answerable') is True and params.get('multiSelect') is not True
        and isinstance(command, str) and len(command) <= 4000
        and not re.search(r'[\x00-\x08\x0b-\x1f\x7f-\x9f\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069]', command)
        and isinstance(description, str) and len(description) <= 3000
        and isinstance(choices, list) and len(choices) <= 32
        and all(isinstance(choice, str) and 0 < len(choice) <= 200 and choice.strip()
                and not re.search(r'[\x00-\x1f\x7f-\x9f]', choice) for choice in choices)
        and (kind != 'approval' or bool(choices))
    )
    return {'ev': 'prompt', 'promptId': text(params.get('promptId'), 128), 'kind': kind,
            'text': text(description[:3000], 3000, empty=True),
            'command': command if answerable else '', 'choices': choices if answerable else [],
            'multiSelect': params.get('multiSelect') is True, 'answerable': answerable}


async def streamed(client, params, reader, on_event, out):
    """client.exchange, plus the agent's prompts out and the user's answers in."""
    loop = asyncio.get_running_loop()
    await client.send('send', 'message.send', params)
    accepted, result, session, asked, answers = False, None, None, 0, {}
    steers = {}
    prompts = set()
    frame_task = asyncio.ensure_future(client.read())
    input_task = asyncio.ensure_future(reader.readline())
    try:
        for _ in range(65536):
            done, _ = await asyncio.wait({frame_task, input_task}, return_when=asyncio.FIRST_COMPLETED)
            if input_task in done:
                raw = input_task.result()
                input_task = asyncio.ensure_future(reader.readline()) if raw else loop.create_future()
                try:
                    answer = json.loads(raw) if raw else None
                except ValueError:
                    answer = None
                if isinstance(answer, dict) and answer.get('op') == 'steer' and accepted and session:
                    asked += 1
                    op = 'steer-%d' % asked
                    steers[op] = text(answer.get('text'), MAX_PROMPT)
                    await client.send(op, 'message.steer', {'agentId': params['agentId'], 'text': steers[op]})
                elif isinstance(answer, dict) and answer.get('op') == 'answer' and session:
                    asked += 1
                    op = 'answer-%d' % asked
                    prompt_id = text(answer.get('promptId'), 128)
                    if prompt_id not in prompts:
                        out({'ev': 'answered', 'promptId': prompt_id, 'ok': False,
                             'text': 'Open Hermes to review this prompt.'})
                    else:
                        answers[op] = prompt_id
                        await client.send(op, 'prompt.answer', {'agentId': params['agentId'], 'sessionId': session,
                                                                'promptId': prompt_id,
                                                                'answer': text(answer.get('answer'), MAX_PROMPT)})
            if frame_task not in done:
                continue
            frame = frame_task.result()
            frame_task = asyncio.ensure_future(client.read())
            if frame.get('id') in steers:
                steered = steers.pop(frame['id'])
                if 'error' in frame:
                    out({'ev': 'steered', 'ok': False, 'text': steered,
                         'status': text(frame['error'].get('message', 'Steer was not taken.'), 400)})
                else:
                    status = str((frame.get('result') or {}).get('status') or '')
                    out({'ev': 'steered', 'ok': status == 'queued', 'text': steered, 'status': status})
            if frame.get('id') == 'send':
                if frame.get('result', {}).get('accepted') is not True:
                    error = frame.get('error', {})
                    raise Fault(str(error.get('code', 'adapter_error'))[:64],
                                str(error.get('message', 'Provider refused the request.'))[:400])
                accepted = True
                session = frame['result'].get('sessionId') or session
            elif frame.get('id') in answers:
                prompt_id = answers.pop(frame['id'])
                if 'error' in frame:
                    out({'ev': 'answered', 'promptId': prompt_id, 'ok': False,
                         'text': text(frame['error'].get('message', 'The answer was not taken.'), 400)})
                elif frame.get('result', {}).get('accepted') is True:
                    out({'ev': 'answered', 'promptId': prompt_id, 'ok': True})
                else:
                    out({'ev': 'answered', 'promptId': prompt_id, 'ok': False,
                         'text': 'The provider did not confirm the answer.'})
            event = frame.get('event')
            payload = frame.get('params', {})
            if payload.get('agentId') == params['agentId'] and event in ('prompt.required', 'prompt.settled'):
                session = payload.get('sessionId') or session
                if event == 'prompt.required':
                    prompt = prompt_line(payload)
                    if prompt['answerable']:
                        prompts.add(prompt['promptId'])
                    else:
                        prompts.discard(prompt['promptId'])
                    out(prompt)
                else:
                    prompt_id = text(payload.get('promptId'), 128)
                    prompts.discard(prompt_id)
                    out({'ev': 'settled', 'promptId': prompt_id})
            elif event and payload.get('requestId') == params['requestId'] and payload.get('agentId') == params['agentId']:
                on_event(frame)
                if event in ('message.finished', 'message.deferred'):
                    result = (event, payload)
            if accepted and result is not None:
                return result
        raise Fault('limit_exceeded', 'Provider event limit reached.')
    finally:
        for task in (frame_task, input_task):
            task.cancel()
        await asyncio.gather(frame_task, input_task, return_exceptions=True)


async def read_request(reader):
    if stat.S_ISREG(os.fstat(sys.stdin.fileno()).st_mode):
        reader.feed_eof()
        return decode(sys.stdin.buffer.read(MAX_FRAME + 1))

    loop = asyncio.get_running_loop()
    await loop.connect_read_pipe(lambda: asyncio.StreamReaderProtocol(reader), sys.stdin)
    first = await reader.readline()
    try:
        header = decode(first)
    except Fault as exc:
        if exc.code != 'invalid_request':
            raise
    else:
        if header.get('stream') is True:
            return header

    # Plain asks keep the original whole-stdin JSON contract, including pretty-printed input.
    try:
        tail = await reader.readexactly(MAX_FRAME + 1 - len(first))
    except asyncio.IncompleteReadError as exc:
        tail = exc.partial
    return decode(first + tail)


async def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--provider', choices=['grokbot', 'hermes', 'example'], default='grokbot')
    args = parser.parse_args()
    reader = asyncio.StreamReader(limit=MAX_FRAME + 1)
    payload = await read_request(reader)
    params = dict(agentId=identifier(payload.get('botId')), requestId=identifier(payload.get('askId')),
                  text=text(payload.get('prompt'), MAX_PROMPT), attachments=payload.get('attachments', []))
    seconds = timeout_seconds()
    params['timeoutSeconds'] = seconds
    provider = payload.get('provider', args.provider)
    stream = payload.get('stream') is True

    def out(event):
        sys.stdout.write(json.dumps(event, ensure_ascii=False) + '\n')
        sys.stdout.flush()

    def line(kind, value):
        out({'ev': kind, 'text': value})
    client = client_for(provider)
    task = asyncio.current_task()
    asyncio.get_running_loop().add_signal_handler(signal.SIGTERM, task.cancel)
    try:
        async with asyncio.timeout(seconds + 15):
            await client.start()
            def on_event(frame):
                if frame.get('event') == 'prompt.required' and not stream:
                    raise Fault('approval_required', 'Hermes needs input or approval. Open Hermes to review it; this desktop request has stopped.')
                if not stream:
                    return
                value = (frame.get('params') or {}).get('text')
                if frame.get('event') == 'message.delta' and isinstance(value, str) and value:
                    line('delta', text(value, 65536))
                elif frame.get('event') == 'message.progress' and isinstance(value, str) and value.strip():
                    line('progress', text(value, 200))
            if stream:
                event, result = await streamed(client, params, reader, on_event, out)
            else:
                event, result = await client.exchange(params, deferred=True, on_event=on_event)
            if event == 'message.deferred':
                if result.get('deliveryId') != params['requestId']:
                    raise Fault('invalid_response', 'Reply identity changed; cannot route a deferred reply.')
                return 10
            if result.get('status') != 'completed':
                error = result.get('error', {})
                raise Fault(str(error.get('code', 'failed')), str(error.get('message', 'The request stopped.'))[:400])
            if stream:
                line('final', text(result.get('text') or '', 65536, empty=True))
            else:
                sys.stdout.write(text(result.get('text'), 65536) + '\n')
            return 0
    finally:
        await client.close()


if __name__ == '__main__':
    try:
        sys.exit(asyncio.run(main()))
    except Fault as exc:
        print(exc.message, file=sys.stderr)
        sys.exit(1)
    except (OSError, TimeoutError, ValueError):
        print('Provider connection failed; inspect the agent before retrying.', file=sys.stderr)
        sys.exit(1)
    except (asyncio.CancelledError, KeyboardInterrupt):
        sys.exit(130)
