#!/usr/bin/python3 -I
"""Compatibility boundary between the desktop's one-shot ask and Provider API v1.

By default stdout carries only the completed reply. When the request asks for
"stream": true, stdout is JSON Lines instead, one object per line, for the shell to
show the reply as it is written:

  {"ev": "delta", "text": <the reply so far>}
  {"ev": "progress", "text": <what the agent is doing>}
  {"ev": "final", "text": <the completed reply>}

Exit codes and stderr are the same either way."""
import json
import argparse
import asyncio
from pathlib import Path
import signal
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from agent_desktop.config import client_for, timeout_seconds
from agent_desktop.protocol import Fault, decode, identifier, text, MAX_PROMPT, MAX_FRAME


async def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--provider', choices=['grokbot', 'hermes', 'example'], default='grokbot')
    args = parser.parse_args()
    payload = decode(sys.stdin.buffer.read(MAX_FRAME + 1))
    params = dict(agentId=identifier(payload.get('botId')), requestId=identifier(payload.get('askId')),
                  text=text(payload.get('prompt'), MAX_PROMPT), attachments=payload.get('attachments', []))
    seconds = timeout_seconds()
    params['timeoutSeconds'] = seconds
    provider = payload.get('provider', args.provider)
    stream = payload.get('stream') is True

    def line(kind, value):
        sys.stdout.write(json.dumps({'ev': kind, 'text': value}, ensure_ascii=False) + '\n')
        sys.stdout.flush()
    client = client_for(provider)
    task = asyncio.current_task()
    asyncio.get_running_loop().add_signal_handler(signal.SIGTERM, task.cancel)
    try:
        async with asyncio.timeout(seconds + 15):
            await client.start()
            def on_event(frame):
                if frame.get('event') == 'prompt.required':
                    raise Fault('approval_required', 'Hermes needs input or approval. Open Hermes to review it; this desktop request has stopped.')
                if not stream:
                    return
                value = (frame.get('params') or {}).get('text')
                if frame.get('event') == 'message.delta' and isinstance(value, str) and value:
                    line('delta', text(value, 65536))
                elif frame.get('event') == 'message.progress' and isinstance(value, str) and value.strip():
                    line('progress', text(value, 200))
            event, result = await client.exchange(params, deferred=True, on_event=on_event)
            if event == 'message.deferred':
                if result.get('deliveryId') != params['requestId']:
                    raise Fault('invalid_response', 'Reply identity changed; cannot route a deferred reply.')
                return 10
            if result.get('status') != 'completed':
                error = result.get('error', {})
                raise Fault(str(error.get('code', 'failed')), str(error.get('message', 'The request stopped.'))[:400])
            if stream:
                line('final', text(result.get('text'), 65536))
            else:
                sys.stdout.write(text(result.get('text'), 65536) + '\n')
            return 0
    finally:
        await client.close()


if __name__ == '__main__':
    try:
        sys.exit(asyncio.run(main()))
    except Fault as exc:
        print(exc.message, file=sys.stderr)
        sys.exit(1)
    except (OSError, TimeoutError, ValueError):
        print('Provider connection failed; inspect the agent before retrying.', file=sys.stderr)
        sys.exit(1)
    except (asyncio.CancelledError, KeyboardInterrupt):
        sys.exit(130)
